    "@remotion/renderer": "4.0.532",
    "@remotion/whisper-webgpu": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "pngjs": "7.0.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
