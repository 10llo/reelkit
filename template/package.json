    "@remotion/fonts": "4.0.532",
    "@remotion/layout-utils": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/zod-types": "4.0.532",
    "mediabunny": "1.56.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mediabunny/server": "1.61.3",
    "@remotion/bundler": "4.0.532",
