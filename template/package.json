{
  "name": "reelkit-template",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio --public-dir examples/dani-chocolate",
    "reelkit": "tsx scripts/reelkit.ts",
